    "episode": {
      "turn_budget": 15,
      "round_width": 5,
      "revealed_width": 5,
      "blind_round": true,
      "dominance_cap": 50,
      "repetition_cap": 3,
      "distance": "sequence",
      "quorum": {
        "threshold": 3,
        "window": 15,
        "require_grounded": true
      },
      "weights": {
        "recency": 5,
        "importance": 30,
        "relevance": 20,
        "half_life": 20
      }
    },
    "routing": {
      "minimum_confidence": 0,
      "high_impact_minimum_confidence": 0,
      "clarification_threshold": 1000000,
      "high_impact_threshold": 1000000,
      "round_width": 4,
      "choice_option_limit": 8
